// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

}

// =========================================================================
// USERS & CANDIDATE PROFILE
// =========================================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  mobile       String?   @unique
  passwordHash String    @map("password_hash")
  role         String    @default("candidate") @db.VarChar(20)
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  profile              UserProfile?
  preferences          CandidatePreference?
  resumes              Resume[]
  education             Education[]
  experience            CandidateExperience[]
  skills                CandidateSkill[]
  projects              CandidateProject[]
  employerAccounts      EmployerAccount[]
  jobApplications       JobApplication[]
  savedJobs             JobSavedItem[]
  jobAlerts             JobAlert[]
  searchEvents          JobSearchEvent[]
  jobImpressions        JobImpression[]
  jobRecommendations    JobRecommendation[]
  companyReviews        CompanyReview[]
  reviewVotes           ReviewVote[]
  salaryReports         SalaryReport[]
  interviewExperiences  InterviewExperience[]
  companyComparisons    CompanyComparison[]
  subscriptions         UserSubscription[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  refreshSessions       RefreshSession[]
  emailVerified         Boolean   @default(false) @map("email_verified")
  verificationToken     String?   @unique @map("verification_token")
  verificationExpires   DateTime? @map("verification_expires")

  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid @map("refresh_session_id")
  userId    String    @db.Uuid @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model UserProfile {
  id                     String   @id @default(uuid()) @db.Uuid @map("profile_id")
  userId                 String   @unique @db.Uuid @map("user_id")
  firstName              String   @map("first_name")
  lastName               String   @map("last_name")
  birthDate              DateTime? @db.Date @map("birth_date")
  headline               String?
  summary                String?  @db.Text
  totalExperienceMonths  Int?     @map("total_experience_months")
  currentCtc             Decimal? @db.Decimal(12, 2) @map("current_ctc")
  expectedCtc            Decimal? @db.Decimal(12, 2) @map("expected_ctc")
  openToWork             Boolean  @default(false) @map("open_to_work")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model CandidatePreference {
  id                     String   @id @default(uuid()) @db.Uuid @map("preference_id")
  userId                 String   @unique @db.Uuid @map("user_id")
  remotePreferred        Boolean  @default(false) @map("remote_preferred")
  jobAlertEnabled        Boolean  @default(true) @map("job_alert_enabled")
  profileVisible         Boolean  @default(true) @map("profile_visible")
  preferredJobType       String?  @map("preferred_job_type")
  minimumExpectedSalary  Decimal? @db.Decimal(12, 2) @map("minimum_expected_salary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_preferences")
}

model Resume {
  id         String   @id @default(uuid()) @db.Uuid @map("resume_id")
  userId     String   @db.Uuid @map("user_id")
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  parsedText String?  @db.Text @map("parsed_text")
  isPrimary  Boolean  @default(false) @map("is_primary")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplications  JobApplication[]

  @@index([userId])
  @@map("resumes")
}

model Education {
  id                String   @id @default(uuid()) @db.Uuid @map("education_id")
  userId            String   @db.Uuid @map("user_id")
  instituteId       String?  @db.Uuid @map("institute_id")
  qualificationId   String   @db.Uuid @map("qualification_id")
  specializationId  String?  @db.Uuid @map("specialization_id")
  specialization    String?
  startYear         Int?     @map("start_year")
  endYear           Int?     @map("end_year")
  score             Decimal? @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualificationRef      Qualification   @relation(fields: [qualificationId], references: [id])
  specializationRef     Specialization? @relation(fields: [specializationId], references: [id])

  @@index([userId])
  @@map("education")
}

model CandidateExperience {
  id           String    @id @default(uuid()) @db.Uuid @map("experience_id")
  userId       String    @db.Uuid @map("user_id")
  companyName  String    @map("company_name")
  companyId    String?   @db.Uuid @map("company_id")
  designation  String
  startDate    DateTime  @db.Date @map("start_date")
  endDate      DateTime? @db.Date @map("end_date")
  isCurrent    Boolean   @default(false) @map("is_current")
  description  String?   @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@map("candidate_experience")
}

model CandidateSkill {
  id                String  @id @default(uuid()) @db.Uuid @map("candidate_skill_id")
  userId            String  @db.Uuid @map("user_id")
  skillId           String  @db.Uuid @map("skill_id")
  proficiencyLevel  String? @map("proficiency_level")
  experienceMonths  Int?    @map("experience_months")
  isPrimary         Boolean @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@index([userId])
  @@index([skillId])
  @@map("candidate_skills")
}

model CandidateProject {
  id           String    @id @default(uuid()) @db.Uuid @map("project_id")
  userId       String    @db.Uuid @map("user_id")
  projectName  String    @map("project_name")
  description  String?   @db.Text
  projectUrl   String?   @map("project_url")
  startDate    DateTime? @db.Date @map("start_date")
  endDate      DateTime? @db.Date @map("end_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("candidate_projects")
}

// =========================================================================
// COMPANIES
// =========================================================================

model Company {
  id                 String   @id @default(uuid()) @db.Uuid @map("company_id")
  legalName          String   @map("legal_name")
  displayName        String   @map("display_name")
  slug               String   @unique
  companyType        String?  @map("company_type")
  ownershipType      String?  @map("ownership_type")
  foundedYear        Int?     @map("founded_year")
  websiteUrl         String?  @map("website_url")
  verificationStatus String   @default("pending") @map("verification_status")
  isActive           Boolean  @default(true) @map("is_active")
  hrContactName      String?  @map("hr_contact_name")
  contactNumber      String?  @map("contact_number")

  profile               CompanyProfile?
  locations             CompanyLocation[]
  industries            CompanyIndustry[]
  benefits              CompanyBenefit[]
  employerAccounts      EmployerAccount[]
  jobs                  Job[]
  campaigns             JobCampaign[]
  reviews               CompanyReview[]
  salaryReports         SalaryReport[]
  interviewExperiences  InterviewExperience[]
  experienceRecords     CandidateExperience[]
  comparisonsAsPrimary  CompanyComparison[] @relation("PrimaryCompany")
  comparisonsAsCompared CompanyComparison[] @relation("ComparedCompany")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  @@map("companies")
}

model CompanyProfile {
  id                String   @id @default(uuid()) @db.Uuid @map("company_profile_id")
  companyId         String   @unique @db.Uuid @map("company_id")
  aboutCompany      String?  @db.Text @map("about_company")
  logoUrl           String?  @map("logo_url")
  coverImageUrl     String?  @map("cover_image_url")
  employeeCountMin  Int?     @map("employee_count_min")
  employeeCountMax  Int?     @map("employee_count_max")
  overallRating     Decimal? @db.Decimal(3, 2) @map("overall_rating")
  reviewCount       Int      @default(0) @map("review_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model CompanyLocation {
  id              String  @id @default(uuid()) @db.Uuid @map("company_location_id")
  companyId       String  @db.Uuid @map("company_id")
  locationId      String  @db.Uuid @map("location_id")
  officeType      String? @map("office_type")
  isHeadquarters  Boolean @default(false) @map("is_headquarters")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@index([companyId])
  @@index([locationId])
  @@map("company_locations")
}

model CompanyIndustry {
  id          String  @id @default(uuid()) @db.Uuid @map("company_industry_id")
  companyId   String  @db.Uuid @map("company_id")
  industryId  String  @db.Uuid @map("industry_id")
  isPrimary   Boolean @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industry Industry @relation(fields: [industryId], references: [id])

  @@index([companyId])
  @@index([industryId])
  @@map("company_industries")
}

model CompanyBenefit {
  id             String @id @default(uuid()) @db.Uuid @map("company_benefit_id")
  companyId      String @db.Uuid @map("company_id")
  benefitId      String @db.Uuid @map("benefit_id")
  responseCount  Int    @default(0) @map("response_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  benefit Benefit @relation(fields: [benefitId], references: [id])

  @@index([companyId])
  @@index([benefitId])
  @@map("company_benefits")
}

model EmployerAccount {
  id         String    @id @default(uuid()) @db.Uuid @map("employer_account_id")
  userId     String    @db.Uuid @map("user_id")
  companyId  String    @db.Uuid @map("company_id")
  role       String    @default("member")
  status     String    @default("invited")
  invitedAt  DateTime  @default(now()) @map("invited_at")
  joinedAt   DateTime? @map("joined_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdJobs        Job[]                @relation("JobCreatedBy")
  interviewPanelist  InterviewPanelist[]

  @@index([userId])
  @@index([companyId])
  @@map("employer_accounts")
}

// =========================================================================
// JOBS
// =========================================================================

model Job {
  id                   String    @id @default(uuid()) @db.Uuid @map("job_id")
  companyId            String    @db.Uuid @map("company_id")
  createdBy            String    @db.Uuid @map("created_by")
  designationId        String    @db.Uuid @map("designation_id")
  departmentId         String?   @db.Uuid @map("department_id")
  title                String
  description          String    @db.Text
  employmentType       String    @map("employment_type")
  workMode             String    @map("work_mode")
  seniorityLevel       String?   @map("seniority_level")
  minExperienceMonths  Int?      @map("min_experience_months")
  maxExperienceMonths  Int?      @map("max_experience_months")
  minSalary            Decimal?  @db.Decimal(12, 2) @map("min_salary")
  maxSalary            Decimal?  @db.Decimal(12, 2) @map("max_salary")
  salaryCurrency       String    @default("NPR") @map("salary_currency")
  showSalary           Boolean   @default(true) @map("show_salary")
  status               String    @default("draft")
  publishedAt          DateTime? @map("published_at")
  expiresAt            DateTime? @map("expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  company               Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator               EmployerAccount       @relation("JobCreatedBy", fields: [createdBy], references: [id])
  designation           Designation           @relation(fields: [designationId], references: [id])
  department            Department?           @relation(fields: [departmentId], references: [id])
  locations             JobLocation[]
  skills                JobSkill[]
  qualifications        JobQualification[]
  benefits              JobBenefit[]
  tags                  JobTag[]
  media                 JobMedia[]
  applications          JobApplication[]
  savedBy               JobSavedItem[]
  impressions           JobImpression[]
  recommendations       JobRecommendation[]
  sponsoredPlacements   SponsoredJobPlacement[]

  @@index([companyId])
  @@index([designationId])
  @@map("jobs")
}

model JobLocation {
  id         String  @id @default(uuid()) @db.Uuid @map("job_location_id")
  jobId      String  @db.Uuid @map("job_id")
  locationId String  @db.Uuid @map("location_id")
  isPrimary  Boolean @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@index([jobId])
  @@index([locationId])
  @@map("job_locations")
}

model JobSkill {
  id                   String  @id @default(uuid()) @db.Uuid @map("job_skill_id")
  jobId                String  @db.Uuid @map("job_id")
  skillId              String  @db.Uuid @map("skill_id")
  importance           String? @default("nice_to_have")
  minExperienceMonths  Int?    @map("min_experience_months")
  isMandatory          Boolean @default(false) @map("is_mandatory")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@index([jobId])
  @@index([skillId])
  @@map("job_skills")
}

model JobQualification {
  id                String  @id @default(uuid()) @db.Uuid @map("job_qualification_id")
  jobId             String  @db.Uuid @map("job_id")
  qualificationId   String  @db.Uuid @map("qualification_id")
  specializationId  String? @db.Uuid @map("specialization_id")
  isRequired        Boolean @default(true) @map("is_required")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  qualification  Qualification   @relation(fields: [qualificationId], references: [id])
  specialization Specialization? @relation(fields: [specializationId], references: [id])

  @@index([jobId])
  @@map("job_qualifications")
}

model JobBenefit {
  id        String @id @default(uuid()) @db.Uuid @map("job_benefit_id")
  jobId     String @db.Uuid @map("job_id")
  benefitId String @db.Uuid @map("benefit_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  benefit Benefit @relation(fields: [benefitId], references: [id])

  @@index([jobId])
  @@map("job_benefits")
}

model JobTag {
  id     String @id @default(uuid()) @db.Uuid @map("job_tag_id")
  jobId  String @db.Uuid @map("job_id")
  tagId  String @db.Uuid @map("tag_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id])

  @@index([jobId])
  @@map("job_tags")
}

model JobMedia {
  id        String @id @default(uuid()) @db.Uuid @map("job_media_id")
  jobId     String @db.Uuid @map("job_id")
  mediaType String @map("media_type")
  mediaUrl  String @map("media_url")
  caption   String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_media")
}

model JobCampaign {
  id           String   @id @default(uuid()) @db.Uuid @map("campaign_id")
  companyId    String   @db.Uuid @map("company_id")
  campaignType String   @map("campaign_type")
  budget       Decimal  @db.Decimal(12, 2)
  startsOn     DateTime @db.Date @map("starts_on")
  endsOn       DateTime @db.Date @map("ends_on")
  status       String   @default("active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  placements SponsoredJobPlacement[]

  @@index([companyId])
  @@map("job_campaigns")
}

model SponsoredJobPlacement {
  id             String   @id @default(uuid()) @db.Uuid @map("placement_id")
  campaignId     String   @db.Uuid @map("campaign_id")
  jobId          String   @db.Uuid @map("job_id")
  placementType  String   @map("placement_type")
  bidAmount      Decimal  @db.Decimal(12, 2) @map("bid_amount")
  priority       Int      @default(0)
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")

  campaign JobCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  job      Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([jobId])
  @@map("sponsored_job_placements")
}

// =========================================================================
// APPLICATIONS / INTERVIEWS
// =========================================================================

model JobApplication {
  id            String    @id @default(uuid()) @db.Uuid @map("application_id")
  jobId         String    @db.Uuid @map("job_id")
  candidateId   String    @db.Uuid @map("candidate_id")
  resumeId      String    @db.Uuid @map("resume_id")
  source        String?   @default("website")
  status        String    @default("applied")
  coverLetter   String?   @db.Text @map("cover_letter")
  appliedAt     DateTime  @default(now()) @map("applied_at")
  withdrawnAt   DateTime? @map("withdrawn_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  job              Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate        User                       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resume           Resume                     @relation(fields: [resumeId], references: [id])
