  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  @@map("benefits")
}

model Tag {
  id      String @id @default(uuid()) @db.Uuid @map("tag_id")
  tagName String @unique @map("tag_name")
  tagType String @map("tag_type")

  jobTags JobTag[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")
  deletedAt DateTime? @map("deleted_at")
  @@map("tags")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid @map("audit_log_id")
  actorUserId  String?  @db.Uuid @map("actor_user_id")
  entityType   String   @map("entity_type")
  entityId     String   @db.Uuid @map("entity_id")
  action       String
  beforeData   Json?    @map("before_data")
  afterData    Json?    @map("after_data")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
