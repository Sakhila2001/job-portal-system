"use client";

import { useState, useMemo, useEffect, useCallback } from "react";
import { useAuth } from "@/contexts/AuthContext";
import {
  MOCK_RECRUITER_KPIS,
  MOCK_PLAN_USAGE,
  MOCK_JOB_APPLICANTS,
  MOCK_HIRING_ANALYTICS,
  MOCK_RECRUITER_CAMPAIGNS,
